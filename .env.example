# Sample mode works without keys. Never commit your populated .env.
GROQ_API_KEY=
TAVILY_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Required to enable live runs, even on localhost. Use a long random token.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
APP_ACCESS_TOKEN=
MAX_LIVE_RUNS_PER_DAY=50

# Set true behind HTTPS. Keep false for http://127.0.0.1 local development.
COOKIE_SECURE=false

# Optional USD rates from YOUR provider plan; blank means cost is unavailable.
GROQ_INPUT_USD_PER_MILLION=
GROQ_OUTPUT_USD_PER_MILLION=
TAVILY_USD_PER_CREDIT=

# Optional database path (defaults to data/runs.sqlite3).
# LEADFLOW_DB=
